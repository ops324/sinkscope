DJANGO_SECRET_KEY=dev-insecure-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=sinkscope
DB_USER=sinkscope
DB_PASSWORD=sinkscope
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

# ingestスクリプトの生データキャッシュ先。docker-compose.ymlは./data:/dataを
# マウントするため、コンテナ内既定値は/data/raw。コンテナ外(ローカル/CI)で
# 実行する場合は未設定のままでよく、その場合はリポジトリ直下のdata/rawに
# フォールバックする(backend/config/settings.py参照)。
RAW_DATA_DIR=/data/raw
