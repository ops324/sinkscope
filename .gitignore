# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.Python
build/
dist/
*.sqlite3
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Django
backend/staticfiles/
backend/media/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
*.local
# tsconfig.node.json(composite)がvite.config.tsを型検査する際にtsc -bが
# 誤ってここへ吐き出すことがあるビルド副産物(ソースはvite.config.tsのみ)。
frontend/vite.config.js
frontend/vite.config.d.ts

# Env / secrets
.env
.env.*
!.env.example
# 単一URL配信(D7)の静的ビルド設定はコミットする(Pagesビルドが参照するため)。
# 上の .env.* に巻き込まれて無視されるのを防ぐ明示的な除外。
!frontend/.env.static

# Data (large binaries; keep dirs via .gitkeep, not contents)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# 単一URL配信(D7): export_static の一時出力先(コミット対象は frontend/public/data/)。
data/web-export/

# Notebooks checkpoints
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/
.claude/
*.swp
